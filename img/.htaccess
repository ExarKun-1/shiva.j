# v89: u mapi sa slikama ništa se ne izvršava (admin ovdje sprema samo .jpg)
<FilesMatch "\.(php\d?|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
# (bez „Options”: Plesk često ne dopušta ExecCGI u .htaccess → 500; popis mape već isključuje korijenski .htaccess)
