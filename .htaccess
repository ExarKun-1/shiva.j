Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/(status|reserve|order|confirm|storno)/?$ api/index.php?a=$1 [L,QSA]
  RewriteRule ^admin/?$ admin/index.php [L,QSA]
</IfModule>

# Datoteke iz repozitorija koje nisu za javnost (ako se na hosting prenese cijela mapa):
# git, upute, dokumenti, primjeri, lokalni router, pomoćna PHP datoteka admina
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)^/(\.git|\.gitignore|docs/|tests/|README\.md|[^/]+\.md|torbe\.primjer\.json|torbe\.json\.example|router\.php|admin/lib\.php|data/|PROCITAJ\.txt|tools/|proba/|dist/|\.github/|\.impeccable/|reports/|research_notes/|.*\.(md|py|gs|zip|sh|log|bak)$)
</IfModule>

<IfModule mod_headers.c>
  <Files "torbe.json">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  Header set X-Content-Type-Options "nosniff"
</IfModule>
