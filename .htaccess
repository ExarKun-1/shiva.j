Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/(status|reserve|order|confirm|storno|paidclaim|raskid)/?$ api/index.php?a=$1 [L,QSA]
  RewriteRule ^admin/?$ admin/index.php [L,QSA]
</IfModule>

# Datoteke iz repozitorija koje nisu za javnost (ako se na hosting prenese cijela mapa):
# git, upute, dokumenti, primjeri, lokalni router, pomoćna PHP datoteka admina
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)^/(\.git|\.gitignore|docs/|tests/|README\.md|[^/]+\.md|torbe\.primjer\.json|torbe\.json\.example|router\.php|admin/lib\.php|admin/pdf417|data/|PROCITAJ\.txt|tools/|proba/|dist/|\.github/|\.impeccable/|reports/|research_notes/|.*\.(md|py|gs|zip|sh|log|bak)$)
</IfModule>

<IfModule mod_headers.c>
  <Files "torbe.json">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  Header set X-Content-Type-Options "nosniff"
  # v77 (recenzija R76-S5): stranica se ne smije umetati u tuđe stranice (clickjacking); setifempty — admin i
  # storno šalju vlastiti, stroži CSP i DENY iz PHP-a, koji se ne smije pregaziti
  Header setifempty X-Frame-Options "SAMEORIGIN"
  Header setifempty Content-Security-Policy "frame-ancestors 'self'"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
