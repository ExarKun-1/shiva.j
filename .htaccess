Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteRule ^api/(status|reserve|order|confirm|storno|paidclaim|raskid)/?$ api/index.php?a=$1 [L,QSA]
  RewriteRule ^admin/?$ admin/index.php [L,QSA]
</IfModule>

# Datoteke iz repozitorija koje nisu za javnost (ako se na hosting prenese cijela mapa):
# git, upute, dokumenti, primjeri, lokalni router, pomoćna PHP datoteka admina
<IfModule mod_alias.c>
  RedirectMatch 404 (?i)^/(\.git|\.gitignore|docs/|tests/|README\.md|[^/]+\.md|torbe\.primjer\.json|torbe\.json\.example|router\.php|admin/lib\.php|admin/pdf417|data/|PROCITAJ\.txt|tools/|proba/|dist/|\.github/|\.impeccable/|reports/|research_notes/|.*\.(md|py|gs|zip|sh|log|bak)$)
</IfModule>

<IfModule mod_headers.c>
  <Files "torbe.json">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  Header set X-Content-Type-Options "nosniff"
  # v77 (recenzija R76-S5): stranica se ne smije umetati u tuđe stranice (clickjacking); setifempty — admin i
  # storno šalju vlastiti, stroži CSP i DENY iz PHP-a, koji se ne smije pregaziti
  Header setifempty X-Frame-Options "SAMEORIGIN"
  # v95 (recenzija vijeća v94, sigurnost 7): skripte samo s ove stranice (i ugrađene) i karta BOX NOW; bez eval-a, bez
  # dodataka (object), bez tuđe osnovne adrese (base) i tuđih obrazaca; izračun „niste robot” radi u Workeru (blob:)
  # v96 (recenzija vijeća v95, sigurnost N7): paket (tools/paket.py) ovdje upisuje 'sha256-…' ugrađene skripte — tada preglednici
  # ignoriraju 'unsafe-inline' (ostaje samo za stare preglednike); slike, veze i okviri samo s ove stranice i BOX NOW
  # v98 (recenzija vijeća v97, sigurnost L2): default-src 'self' — stilovi i pisma samo s ove stranice, fonts.bunny.net i BOX NOW
  Header setifempty Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.bunny.net https://*.boxnow.hr; font-src 'self' data: https://fonts.bunny.net https://*.boxnow.hr; script-src 'self' 'unsafe-inline' https://widget-cdn.boxnow.hr; worker-src 'self' blob:; connect-src 'self' https://*.boxnow.hr; img-src 'self' data: blob: https://*.boxnow.hr; frame-src 'self' https://*.boxnow.hr; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# v95 (recenzija vijeća v94, mobitel): sažimanje teksta (index.html ima oko 280 KB, sažet oko 90 KB) — brže na sporoj mreži
<IfModule mod_deflate.c>
  <IfModule mod_filter.c>
    # v96 (recenzija vijeća v95): AddOutputFilterByType je u Apacheu 2.4 dio mod_filter — bez njega ne smije srušiti stranicu
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json image/svg+xml
  </IfModule>
</IfModule>
